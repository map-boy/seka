# Values here are read by the Secrets Gradle Plugin (see app/build.gradle.kts)
# and exposed as BuildConfig fields. This file holds the defaults; copy it to
# .env for local overrides. .env is gitignored, .env.example is not, so never
# put a real secret in this file.
#
# The app has no AI provider key of its own: the RAG features are served by
# Cloud Functions in 2_backend/functions.
