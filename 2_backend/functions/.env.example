# Seka RAG backend configuration.
#
# Everything here is optional. With no variables set the functions run on the
# built-in local embedder and the extractive answerer: no keys, no vendor, no
# network calls. Set these to wire a real provider.
#
# Non-secret values go in .env (committed per-project as .env.<project> if you
# like); the two API keys are Cloud Functions secrets:
#   firebase functions:secrets:set RAG_EMBEDDING_API_KEY
#   firebase functions:secrets:set RAG_CHAT_API_KEY

# --- Embeddings (drives search, recommendations and assistant retrieval) ---
# local = built-in feature-hashing embedder (default, lexical only)
# http  = any vendor with a POST {model, input:[...]} embeddings endpoint
RAG_EMBEDDING_PROVIDER=local
# RAG_EMBEDDING_URL=https://api.example.com/v1/embeddings
# RAG_EMBEDDING_MODEL=your-embedding-model
# RAG_EMBEDDING_BATCH_SIZE=32
# Dimension of the built-in local embedder only. Changing it invalidates the
# index -- re-run backfillMemeIndex with force=true afterwards.
# RAG_EMBEDDING_DIMENSION=1024

# --- Answer generation (assistant only) ---
# local     = extractive, no model call (default)
# anthropic = official Anthropic SDK
# http      = any vendor with a POST {model, messages:[...]} completions endpoint
RAG_CHAT_PROVIDER=local
# RAG_CHAT_MODEL=claude-opus-5
# RAG_CHAT_URL=https://api.example.com/v1/chat/completions
# RAG_CHAT_MAX_TOKENS=1024

# --- Retrieval tuning ---
# RAG_TOP_K=8
# RAG_MIN_SCORE=0.05
# RAG_CANDIDATE_LIMIT=5000
# RAG_INDEX_CACHE_TTL_MS=60000

# --- Admin ---
# Comma-separated uids allowed to call backfillMemeIndex. Unset = nobody.
# RAG_ADMIN_UIDS=
